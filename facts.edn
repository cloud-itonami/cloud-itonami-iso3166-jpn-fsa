 ;; ── CONTROLS ───────────────────────────────────────────────────────────
 ;; Cited for NO proposition. These exist so that the repeal, revision and
 ;; identity checks are checks rather than constants: each one is a live
 ;; instance of a state the checks claim to detect. Delete them and the
 ;; verifier keeps passing while having stopped discriminating.

 {:source/id :law/repealed-control
  :source/verify :statute-api
  :source/role "CONTROL, not a citation. A repealed Act that the API still
                serves in full at total_count 1 -- so only the repeal field
                separates it from a live one. It also flags remain_in_force
                TRUE while being repealed, which is why that field is not
                read as an answer to whether a law is operative."
  :statute/law-id "324AC0000000068"
  :statute/title "簡易生命保険法"
  :statute/law-num "昭和二十四年法律第六十八号"
  :statute/kind "Act"
  :statute/promulgated "1949-05-16"
  :statute/repealed? true
  :statute/repeal-token "Repeal"
  :statute/repeal-date "2020-04-01"
  :statute/remain-in-force? true
  :statute/enforced? false}

 {:source/id :law/previous-enforced-control
  :source/verify :statute-api
  :source/role "CONTROL, not a citation. The subtle one: repeal_status is
                None -- this Act was never repealed -- yet the revision the
                API serves is PreviousEnforced rather than CurrentEnforced. A
                verifier that reads only repeal_status calls this in force and
                hands back superseded text. This entry is the reason
                :statute/enforced? exists as a separate assertion."
  :statute/law-id "329AC0000000115"
  :statute/title "厚生年金保険法"
  :statute/law-num "昭和二十九年法律第百十五号"
  :statute/kind "Act"
  :statute/promulgated "1954-05-19"
  :statute/repealed? false
  :statute/enforced? false}

 {:source/id :law/previous-enforced-control-2
  :source/verify :statute-api
  :source/role "CONTROL, not a citation. A SECOND law in the not-repealed-but-
                superseded state, because one instance reads as an oddity and
                two read as a state the API actually has. It also keeps the
                register verifiable while that state is under test: the
                structural floor in verify-facts.cljs refuses a register with
                no superseded control, so with only one entry a test that
                mis-declares it gets REFUSED by the floor before the
                enforcement check can fire, and the check would never be seen
                to work. break-tests.cljs case 9b is exactly that test."
  :statute/law-id "343AC1000000089"
  :statute/title "社会保険労務士法"
